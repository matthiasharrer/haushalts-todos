// Prisma schema for Haushalt. SQLite (WAL mode enabled at runtime in src/db.ts).
// The connection URL lives in prisma.config.ts; the app connects through a
// driver adapter built from DATABASE_URL (src/db.ts).

// Output is under apps/api/src so tsc compiles it into dist/generated/prisma.
// It's gitignored build output — regenerate with `npm run db:generate`.
// moduleFormat/importFileExtension are explicit because the compiled output
// runs as plain Node ESM, where relative imports need a `.js` extension.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

/// A person, created on first request from the Authelia Remote-* headers.
model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  displayName String
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  completions Completion[]
  mcpClients  McpClient[]
  pushSubscriptions PushSubscription[]
  /// Push (ADR-0009): daily digest on/off, local time "HH:MM" (Europe/Berlin),
  /// and the Berlin date the daily run last happened for this user.
  digestEnabled Boolean @default(true)
  notifyTime    String  @default("08:00")
  notifyRunOn   String?
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
}

enum RecurrenceMode {
  AFTER_COMPLETION
  FIXED
}

enum TriggerRefire {
  PUSH
  NONE
}

enum CompletionKind {
  DONE
  SKIPPED
}

/// One row per task, recurring or not (ADR-0004). dueDate is a calendar date
/// "YYYY-MM-DD" (Europe/Berlin). recurrence* fields are all-null or all-set.
model Task {
  id              Int             @id @default(autoincrement())
  title           String
  notes           String?
  priority        Priority        @default(NORMAL)
  dueDate         String?
  recurrenceEvery Int?
  recurrenceUnit  RecurrenceUnit?
  recurrenceMode  RecurrenceMode?
  seasonFrom      Int?
  seasonTo        Int?
  /// Push when it becomes due (ADR-0009); notifiedFor = the dueDate already pushed for.
  notify          Boolean         @default(false)
  notifiedFor     String?
  /// Trigger task (ADR-0010): non-null marks the kind. Waiting = dueDate null,
  /// fired = dueDate set. hookTokenHash = sha256 of the HA bearer token.
  triggerRefire   TriggerRefire?
  hookTokenHash   String?
  firedAt         DateTime?
  /// Follow-up (ADR-0011): this trigger task fires `afterHours` after the
  /// completion of `afterTask`. fireAt = the pending fire time;
  /// fireAtCompletionId = the completion that scheduled it (no FK; undo clears it).
  afterTaskId        Int?
  afterTask          Task?     @relation("FollowUp", fields: [afterTaskId], references: [id])
  followUps          Task[]    @relation("FollowUp")
  afterHours         Int?
  fireAt             DateTime?
  fireAtCompletionId Int?
  doneAt          DateTime?
  archivedAt      DateTime?
  createdById     Int
  createdBy       User            @relation(fields: [createdById], references: [id])
  createdVia      String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completions     Completion[]

  @@index([archivedAt, doneAt, dueDate])
}

/// The log: one row per tick-off or skip. Undo deletes the latest one.
model Completion {
  id            Int            @id @default(autoincrement())
  taskId        Int
  task          Task           @relation(fields: [taskId], references: [id])
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  via           String
  kind          CompletionKind
  at            DateTime       @default(now())
  date          String
  dueDateBefore String?

  @@index([taskId, at])
}

/// A registered MCP OAuth client (ADR-0006). Only clients are rows; codes and
/// tokens are stateless signed blobs. userId is null from registration until
/// someone approves the consent page; then it is the approving user, for good
/// (a different user can't re-approve it). Revoke = delete the row.
model McpClient {
  id           Int       @id @default(autoincrement())
  clientId     String    @unique // opaque random id handed to the client
  name         String // shown in Settings; from DCR client_name, editable
  redirectUris String // JSON array of registered redirect_uris
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime? // bumped when a token is issued/refreshed

  @@index([userId])
}

/// Small key/value store for server-generated settings (ADR-0009: the VAPID key pair under "vapid").
model AppSetting {
  key   String @id
  value String
}

/// One browser/device that can receive Web Push (ADR-0009). Subscribing an
/// existing endpoint reassigns it. A 404/410 from the push service deletes it.
model PushSubscription {
  id            Int       @id @default(autoincrement())
  endpoint      String    @unique
  p256dh        String
  auth          String
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}
