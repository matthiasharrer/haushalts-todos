# Copy to .env for local development (path is relative to apps/api).
DATABASE_URL="file:./prisma/dev.db"
# Production: DATABASE_URL="file:/data/haushalt.db"

# API port (defaults to 3001 if unset).
# PORT=3001

# Production only: directory with the built SPA (apps/web/dist).
# WEB_DIST=/app/apps/web/dist

# MCP server (ADR-0006). Unset = MCP disabled (/mcp is a 404). When set, this is
# the HMAC secret that signs the stateless OAuth codes/tokens; it is NEVER
# accepted as a bearer. Generate with: openssl rand -base64 32
# Rotating it invalidates every issued token (clients must re-authorize).
# MCP_TOKEN=
# Optional: public origin when the ingress sends no X-Forwarded-* headers.
# PUBLIC_URL=https://haushalt.example.org
