# Copy to .env for local development (path is relative to apps/api).
DATABASE_URL="file:./prisma/dev.db"
# Production: DATABASE_URL="file:/data/haushalt.db"

# API port (defaults to 3001 if unset).
# PORT=3001

# Production only: directory with the built SPA (apps/web/dist).
# WEB_DIST=/app/apps/web/dist
